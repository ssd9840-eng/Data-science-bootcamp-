# Question 6: Replace missing values with mean
print("\n\n6. Replace missing values in Min.Price and Max.Price with mean")
print("-" * 50)

df = pd.read_csv('https://raw.githubusercontent.com/selva86/datasets/master/Cars93_miss.csv')

print("Missing values before:")
print(f"Min.Price: {df['Min.Price'].isna().sum()}")
print(f"Max.Price: {df['Max.Price'].isna().sum()}")

# Calculate means and fill missing values
df['Min.Price'].fillna(df['Min.Price'].mean(), inplace=True)
df['Max.Price'].fillna(df['Max.Price'].mean(), inplace=True)

print("\nMissing values after:")
print(f"Min.Price: {df['Min.Price'].isna().sum()}")
print(f"Max.Price: {df['Max.Price'].isna().sum()}")

print(f"\nFirst 10 rows of Min.Price and Max.Price:")
print(df[['Min.Price', 'Max.Price']].head(10))


# Question 7: Get rows with row sum > 100
print("\n\n7. Get rows with row sum > 100")
print("-" * 50)

df = pd.DataFrame(np.random.randint(10, 40, 60).reshape(-1, 4))

print("DataFrame:")
print(df)

# Calculate row sum
row_sums = df.sum(axis=1)
print(f"\nRow sums:")
print(row_sums)

# Filter rows where sum > 100
filtered_rows = df[row_sums > 100]
print(f"\nRows with sum > 100:")
print(filtered_rows)
print(f"\nNumber of rows with sum > 100: {len(filtered_rows)}")

